    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst bins = item.binary || {};\nconst key = Object.keys(bins)[0];\nif (!key) throw new Error('No video was uploaded.');\nconst b = bins[key];\nconst allowed = ['video/mp4','video/quicktime','video/webm','video/mpeg'];\nif (b.mimeType && !allowed.includes(b.mimeType)) throw new Error(`Unsupported video type: ${b.mimeType}`);\nfunction bytes(v){ if(typeof v==='number') return v; const m=String(v||'').trim().match(/^([0-9.]+)\\s*(B|KB|MB|GB)?$/i); if(!m) return 0; return Math.round(Number(m[1])*({B:1,KB:1024,MB:1048576,GB:1073741824}[(m[2]||'B').toUpperCase()])); }\nconst size=bytes(b.fileSize); if(!size) throw new Error('Could not determine video size.');\nreturn [{json:{instructions:item.json.instructions || '', binaryField:key, fileName:b.fileName || 'video.mp4', mimeType:b.mimeType || 'video/mp4', fileSizeBytes:size, runId:$execution.id, submittedAt:new Date().toISOString()},binary:item.binary}];"
      },
