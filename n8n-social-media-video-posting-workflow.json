    {
      "parameters": {
        "jsCode": "const a=$json; const base={runId:$('Validate Submission').item.json.runId,videoUrl:$('Cloudinary - Upload Video').item.json.secure_url};\nreturn [\n{json:{...base,platform:'linkedin',caption:a.linkedin,ready:false,restriction:'Requires Videos API initialize/upload/finalize and Posts API; select OAuth credential and LINKEDIN_AUTHOR_URN.'}},\n{json:{...base,platform:'instagram',caption:a.instagram,ready:false,restriction:'Requires professional account, Meta publishing permissions, container creation and publish.'}},\n{json:{...base,platform:'x',caption:a.x,ready:false,restriction:'Requires eligible paid X API write/media access and user-context OAuth.'}},\n{json:{...base,platform:'tiktok',caption:a.tiktok,ready:false,restriction:'Requires approved video.publish; unaudited apps post private only; Cloudinary URL prefix must be verified.'}},\n{json:{...base,platform:'facebook',caption:a.facebook,ready:false,restriction:'Requires Page token and asynchronous Reels upload/publish.'}}\n];"
      },
      "id": "fd82ef32-b92f-455c-a38c-ba8ed7c1827c",
      "name": "Create Five Publishing Jobs",
