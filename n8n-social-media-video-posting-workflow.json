      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-lite-latest:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ inline_data: { mime_type: $(\"Validate Submission\").item.json.mimeType, data: $(\"Prepare Gemini Inline Video\").item.json.videoBase64 } }, { text: \"You are a senior social-media editor. Analyze the video and return strict JSON with exactly these string keys: video_summary, linkedin, instagram, x, tiktok, facebook. Never invent facts. LinkedIn: professional, up to 3 hashtags. Instagram: energetic hook, CTA, 3-8 hashtags. X: maximum 280 characters. TikTok: short hook-first, 3-5 hashtags. Facebook: accessible and community-oriented. User instructions: \" + $(\"Validate Submission\").item.json.instructions }] }], generationConfig: { responseMimeType: \"application/json\", temperature: 0.7 } }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "333f0adc-0a89-438f-ad41-3ef7c9d72934",
      "name": "Gemini - Analyze Inline Video and Write Captions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -352,
        400
      ],
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 10000,
      "credentials": {},
      "notes": "Select the same Gemini Header Auth credential."
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.candidates?.[0]?.content?.parts?.map(p=>p.text||'').join('') || '';\nlet c; try { c=JSON.parse(raw.replace(/^```json\\s*|```$/g,'').trim()); } catch(e){ throw new Error('Gemini did not return valid caption JSON: '+raw.slice(0,500)); }\nfor (const k of ['video_summary','linkedin','instagram','x','tiktok','facebook']) if(typeof c[k] !== 'string') throw new Error(`Missing caption field: ${k}`);\nif ([...c.x].length > 280) throw new Error(`X caption is ${[...c.x].length} characters; expected at most 280.`);\nreturn [{json:{...c,cloudinaryUrl:$('Cloudinary - Upload Video').item.json.secure_url,cloudinaryPublicId:$('Cloudinary - Upload Video').item.json.public_id,runId:$('Validate Submission').item.json.runId,instructions:$('Validate Submission').item.json.instructions}}];"
      },
      "id": "0a890d14-9a1c-46e9-b3c8-181586852847",
      "name": "Validate Caption JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -128,
        400
      ]
    },
    {
      "parameters": {
        "defineForm": "json",
        "jsonOutput": "={{JSON.stringify([{fieldLabel:'Video summary',fieldName:'video_summary',fieldType:'textarea',defaultValue:$json.video_summary},{fieldLabel:'LinkedIn caption',fieldName:'linkedin',fieldType:'textarea',defaultValue:$json.linkedin,requiredField:true},{fieldLabel:'Instagram caption',fieldName:'instagram',fieldType:'textarea',defaultValue:$json.instagram,requiredField:true},{fieldLabel:'X caption (max 280 characters)',fieldName:'x',fieldType:'textarea',defaultValue:$json.x,requiredField:true},{fieldLabel:'TikTok caption',fieldName:'tiktok',fieldType:'textarea',defaultValue:$json.tiktok,requiredField:true},{fieldLabel:'Facebook caption',fieldName:'facebook',fieldType:'textarea',defaultValue:$json.facebook,requiredField:true},{fieldLabel:'Decision',fieldName:'decision',fieldType:'radio',fieldOptions:{values:[{option:'Approve'},{option:'Reject'}]},requiredField:true}])}}",
        "options": {
          "formTitle": "Review captions before publishing",
          "formDescription": "Edit any caption, then approve or reject. Nothing is posted before approval.",
          "buttonLabel": "Submit decision"
        }
      },
